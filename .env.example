# Supabase Postgres connection string.
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" / "Transaction pooler" string for the runtime, and
# the "Direct connection" string when running drizzle-kit migrations.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Secret used to sign JWTs (custom auth). Use a long random string.
JWT_SECRET="replace-with-a-long-random-string"

# How long a token stays valid (in seconds). Default is 7 days.
JWT_EXPIRES_IN=604800

# Server port
PORT=8787

# Allowed frontend origin(s) for CORS (comma-separated if more than one)
CORS_ORIGIN="http://localhost:3000"

# Enable AI features (chatbot / live translator). The model is still in
# development, so keep this false unless GEMINI_API_KEY is configured. When
# false, POST /api/chat returns 503 ai_unavailable.
AI_ENABLED=false

# Gemini chatbot configuration. Keep this server-side only.
GEMINI_API_KEY="replace-with-google-ai-studio-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Text -> sign pose service used by the avatar. Results are cached in pose_cache.
SIGNGPT_URL="https://www.signgpt.org/api/translate-pose"
# Sign languages (comma-separated ISO 639-3 codes) that SignGPT should handle.
# Languages not listed here (e.g. "ins" = BISINDO) only use the local sign
# dictionary (/api/signs). Add "ins" here if SignGPT supports it.
SIGNGPT_LANGUAGES="ase"

# signify-model inference server for sign -> text (POST, JSON
# { keypoints: frames x 59 x 3, fps } -> { text, confidence? }). Leave empty to
# disable; POST /api/translator/recognize then returns 503 model_unavailable.
SIGN_MODEL_URL=""

# Comma-separated emails allowed to add/remove entries in the sign dictionary.
ADMIN_EMAILS="demo@signify.app"
